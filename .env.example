# Public URL of the deployed site (no trailing slash). Used for canonical URLs, sitemap, OG and llms.txt.
NEXT_PUBLIC_SITE_URL=https://zufa.co.uk

# Google Analytics 4 measurement ID. Loaded only after the visitor accepts analytics cookies.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-KZKNT733Z9

# Google Search Console ownership token. In Search Console: Settings → Ownership verification → HTML tag,
# copy only the value of the `content` attribute. Renders <meta name="google-site-verification" content="…">.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Enquiry form delivery (catering / private hire / contact) via Resend — https://resend.com
# In development, leaving RESEND_API_KEY empty logs enquiries to the console instead of sending.
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=info@zufa.co.uk
# Must be a verified sender/domain in Resend.
ENQUIRY_FROM_EMAIL="Zufa Website <website@zufa.co.uk>"
